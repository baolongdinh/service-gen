func TestMyServiceService_Delete(t *testing.T) {
	repo := &mockMyServiceRepo{}
	svc := services.NewMyServiceService(repo)

	repo.On("Delete", mock.Anything, "abc123").Return(nil)

	err := svc.Delete(context.Background(), "abc123")

	assert.NoError(t, err)
	repo.AssertExpectations(t)
}

func TestMyServiceService_List_DefaultPagination(t *testing.T) {
	repo := &mockMyServiceRepo{}
	svc := services.NewMyServiceService(repo)

	items := []*models.MyService{{ID: "1", Name: "first"}}
	// List should normalise Page=0 -> 1, PageSize=0 -> 20 before calling the repo.
	expected := repositories.MyServiceFilter{
		Pagination: repositories.Pagination{Page: 1, PageSize: 20},
	}
	repo.On("List", mock.Anything, expected).Return(items, int64(1), nil)

	result, total, err := svc.List(context.Background(), repositories.MyServiceFilter{})

	assert.NoError(t, err)
	assert.Equal(t, int64(1), total)
	assert.Len(t, result, 1)
	repo.AssertExpectations(t)
}
