package middleware

import (
	"net/http"
	"runtime/debug"

	"github.com/my-org/my-service/pkg/logger"
)

// Recovery returns a middleware that recovers from panics, logs the stack trace,
// and returns a 500 Internal Server Error response.
// Without this, a panic in a handler goroutine crashes the entire server process.
func Recovery(log logger.Logger) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			defer func() {
				if rec := recover(); rec != nil {
					log.Error("panic recovered",
						"panic", rec,
						"stack", string(debug.Stack()),
					)
					http.Error(w, "internal server error", http.StatusInternalServerError)
				}
			}()
			next.ServeHTTP(w, r)
		})
	}
}
