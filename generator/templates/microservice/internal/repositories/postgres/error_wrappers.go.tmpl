package postgres

import (
	"errors"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/my-org/my-service/internal/repositories"
)

// WrapError maps PostgreSQL driver errors to typed repository errors.
// Call this on every error returned from a repository method.
func WrapError(err error) error {
	if err == nil {
		return nil
	}
	if errors.Is(err, pgx.ErrNoRows) {
		return repositories.ErrRecordNotFound
	}
	var pgErr *pgconn.PgError
	if errors.As(err, &pgErr) {
		switch pgErr.Code {
		case "23505":
			return repositories.ErrDuplicateKey
		case "23503":
			return repositories.ErrForeignKeyViolation
		}
	}
	return err
}
