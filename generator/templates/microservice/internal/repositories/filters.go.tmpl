package repositories

// Pagination controls result window for list queries.
type Pagination struct {
	Page     int `validate:"min=1"`
	PageSize int `validate:"min=1,max=100"`
}

func (p Pagination) Offset() int {
	if p.Page < 1 {
		return 0
	}
	return (p.Page - 1) * p.PageSize
}

// SortOrder controls result ordering for list queries.
type SortOrder struct {
	Field     string
	Ascending bool
}

// MyServiceFilter is the filter struct for MyServiceRepository.List().
// Add fields here as query requirements grow.
type MyServiceFilter struct {
	Pagination
	Sort     SortOrder
	NameLike string // optional partial name match
}
