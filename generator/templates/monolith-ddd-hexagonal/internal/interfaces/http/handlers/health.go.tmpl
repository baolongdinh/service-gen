package handlers

import (
	"context"
	"encoding/json"
	"net/http"
	"time"
)

// Pinger is satisfied by *postgres.DB, *redis.Client wrappers, or any dependency
// that exposes a Ping method — used for health checks.
type Pinger interface {
	Ping(ctx context.Context) error
}

// Health returns a health-check handler that probes db and cache.
func Health(db, cache Pinger) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
		defer cancel()

		type response struct {
			Status string `json:"status"`
			DB     string `json:"db"`
			Cache  string `json:"cache"`
		}

		resp := response{Status: "ok", DB: "ok", Cache: "ok"}
		code := http.StatusOK

		if err := db.Ping(ctx); err != nil {
			resp.DB = "error: " + err.Error()
			resp.Status = "degraded"
			code = http.StatusServiceUnavailable
		}
		if err := cache.Ping(ctx); err != nil {
			resp.Cache = "error: " + err.Error()
			resp.Status = "degraded"
			code = http.StatusServiceUnavailable
		}

		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(code)
		_ = json.NewEncoder(w).Encode(resp)
	}
}
