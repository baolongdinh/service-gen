# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=8080        # Port the HTTP server listens on inside the container
APP_ENV=development  # Runtime environment: development | staging | production
APP_NAME=my-service  # Service name used in structured log fields

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres          # Hostname; uses docker-compose service name when running via `make up`
DB_PORT=5432              # PostgreSQL port inside the docker-compose network
DB_NAME=my-service-db     # Name of the PostgreSQL database to connect to
DB_USER=my_service        # PostgreSQL role used by the application
DB_PASSWORD=my_servicesecret  # PostgreSQL password — change before production use
DB_SSL_MODE=disable       # SSL mode: disable | require | verify-full (use require+ in production)
DB_MAX_CONNS=10           # pgxpool: maximum number of open connections in the pool
DB_MIN_CONNS=2            # pgxpool: minimum number of idle connections kept alive
DB_PORT_HOST=15432        # Host-side port mapping for direct psql access (avoid conflict with local pg)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis     # Hostname; uses docker-compose service name when running via `make up`
REDIS_PORT=6379      # Redis port inside the docker-compose network
REDIS_PASSWORD=      # Redis AUTH password — leave empty if Redis has no password configured
REDIS_DB=0           # Redis logical database index (0–15)
REDIS_PORT_HOST=16379  # Host-side port mapping for direct redis-cli access (avoid conflict with local redis)

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=debug   # Minimum log level: debug | info | warn | error
LOG_FORMAT=text   # Log output format: text (human-readable) | json (structured, for log aggregators)
